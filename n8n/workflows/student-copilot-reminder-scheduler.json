{
  "name": "Student Copilot - Scheduled Reminders Dispatcher",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger (1 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [180, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.APP_INTERNAL_BASE_URL || 'http://localhost:3000' }}/api/assistant/internal/reminders/due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer ={{ $env.ASSISTANT_INTERNAL_API_SECRET || 'PLACEHOLDER_INTERNAL_SECRET' }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "fetch-due-reminders",
      "name": "Fetch Due Reminders from API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.count }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "has-due-reminders",
      "name": "Has Due Reminders?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [620, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "reminders",
        "options": {}
      },
      "id": "split-reminders",
      "name": "Itemize Reminders",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [840, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.channel }}",
              "operation": "equal",
              "value2": "email"
            }
          ]
        }
      },
      "id": "check-channel",
      "name": "Is Email Channel?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1060, 200]
    },
    {
      "parameters": {
        "fromEmail": "notifications@saberio.ai",
        "toEmail": "={{ $json.userEmail }}",
        "subject": "={{ 'Academic Reminder: ' + $json.eventTitle }}",
        "html": "=<p>Hi {{ $json.userName }},</p><p>This is a reminder for your upcoming academic event: <strong>{{ $json.eventTitle }}</strong>.</p><p>Scheduled at: {{ $json.eventStartAt }}</p><p>Location: {{ $json.eventLocation || 'N/A' }}</p><p>Best of luck from Saberio AI!</p>"
      },
      "id": "send-email-node",
      "name": "Dispatch Email Notification",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1300, 100],
      "credentials": {
        "smtp": {
          "id": "CONFIGURED_SMTP_CREDENTIAL_ID",
          "name": "Student Copilot SMTP"
        }
      }
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "deliveryType",
              "value": "in_app_notification_recorded"
            },
            {
              "name": "status",
              "value": "delivered"
            }
          ]
        },
        "options": {}
      },
      "id": "in-app-delivery",
      "name": "Record In-App Delivery",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_INTERNAL_BASE_URL || 'http://localhost:3000' }}/api/assistant/internal/reminders/deliver",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer ={{ $env.ASSISTANT_INTERNAL_API_SECRET || 'PLACEHOLDER_INTERNAL_SECRET' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"reminderId\": \"{{ $('Itemize Reminders').item.json.reminderId }}\",\n  \"status\": \"delivered\",\n  \"channel\": \"{{ $('Itemize Reminders').item.json.channel }}\"\n}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "record-delivery-api",
      "name": "Confirm Delivery in App Database",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1550, 200]
    }
  ],
  "connections": {
    "Schedule Trigger (1 min)": {
      "main": [
        [
          {
            "node": "Fetch Due Reminders from API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Due Reminders from API": {
      "main": [
        [
          {
            "node": "Has Due Reminders?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Due Reminders?": {
      "main": [
        [
          {
            "node": "Itemize Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Itemize Reminders": {
      "main": [
        [
          {
            "node": "Is Email Channel?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Email Channel?": {
      "main": [
        [
          {
            "node": "Dispatch Email Notification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Record In-App Delivery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch Email Notification": {
      "main": [
        [
          {
            "node": "Confirm Delivery in App Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record In-App Delivery": {
      "main": [
        [
          {
            "node": "Confirm Delivery in App Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
