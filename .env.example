# ==========================================
# SABERIO AI & STUDENT COPILOT ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Google Gemini AI API Configuration
# Server-side key for educational extraction, cheatsheet generation, and question solver
GEMINI_API_KEY=

# 2. Database Configuration (Canonical persistence: MongoDB / Mongoose)
# Provide your MongoDB Atlas connection string (or local MongoDB connection string if running mongod)
# IMPORTANT: When using MongoDB Atlas, ensure your IP address or 0.0.0.0/0 is whitelisted in Atlas Network Access.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/saberio?retryWrites=true&w=majority

# 3. Application Security & Authentication
# Required: Random 32+ character secret for signing user JWTs (Server fails closed if missing)
JWT_SECRET=saberio_ai_jwt_production_secret_key_2026_super_secure

# 4. Google OAuth 2.0 Credentials (Optional, for Google Sign-In button)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 5. Student Copilot & n8n Automation Engine
# URL to trigger the imported n8n event automation workflow
# Example: http://localhost:5678/webhook/student-copilot-events
N8N_EVENT_WEBHOOK_URL=

# Shared secret sent in the X-Webhook-Secret header to authenticate calls to n8n
N8N_WEBHOOK_SECRET=

# The internal base URL where n8n can call back to Saberio AI API
# Example: http://localhost:3000
APP_INTERNAL_BASE_URL=http://localhost:3000

# Secret token used by n8n to authenticate to /api/assistant/internal/* routes
ASSISTANT_INTERNAL_API_SECRET=

# 6. Optional Admin Whitelist
# Comma-separated emails that have administrator access
ADMIN_EMAILS=akm007ab@gmail.com

# 7. Optional Razorpay Payment Gateway (Subscription / Pro Tier)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
